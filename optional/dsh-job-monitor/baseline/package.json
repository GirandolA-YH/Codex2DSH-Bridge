{
  "name": "dsh-monitor",
  "version": "1.0.0",
  "private": true,
  "description": "本机只读 DSH 作业监控面板：只读取 dsh-codex-bridge 的 state 目录元数据（job.json 白名单字段、日志文件元数据、owner 心跳），不读取日志原文、不拉起桥、不写任何状态。",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "main": "server.mjs",
  "scripts": {
    "start": "node server.mjs",
    "dump": "node server.mjs --dump",
    "test": "node --test test/",
    "test:files": "node test/run-all.mjs",
    "hash": "node scripts/hash-sources.mjs"
  },
  "dependencies": {},
  "devDependencies": {}
}
